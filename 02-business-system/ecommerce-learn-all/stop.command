#!/bin/zsh
# 电商学习项目 · 一键停止（macOS 双击运行）
# 脚本位于 ecommerce-learn-all/ 合并根目录
# 关闭后端(8080) 与前端(5173) 进程（按端口精准关停，与脚本位置无关）

cd "$(dirname "$0")"

echo "========================================="
echo "   电商学习项目 · 一键停止"
echo "========================================="

echo "关闭后端(8080) ..."
lsof -ti tcp:8080 2>/dev/null | xargs -r kill -9 2>/dev/null && echo "  ✓ 已停止" || echo "  - 无运行实例"

echo "关闭前端(5173) ..."
lsof -ti tcp:5173 2>/dev/null | xargs -r kill -9 2>/dev/null && echo "  ✓ 已停止" || echo "  - 无运行实例"

echo "========================================="
echo "   已停止本项目的后端与前端进程"
echo "   （MySQL / Redis 为本机常驻服务，未做停止）"
echo "========================================="
