# ===== OS / 编辑器 / 智能体编程残留 =====
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/
.workbuddy/

# ===== Java / Maven 构建产物 =====
target/
*.class
*.jar
!**/src/**/*.jar

# ===== 前端 / Node 依赖与构建产物 =====
node_modules/
dist/
.output/
.nuxt/
.cache/
*.tsbuildinfo

# ===== Docker 运行数据（保留 compose 编排文件）=====
**/volumes/

# ===== 日志 =====
*.log
**/logs/*
!**/docs/logs/*

# ===== H2 / SQLite 运行数据库（不是源码）=====
*.mv.db
*.trace.db
*.sqlite
*.sqlite3

# ===== 一键脚本的运行态（PID / 日志 / 临时）=====
.run/
*.pid

# ===== 密钥 / 环境变量（本仓库统一用环境变量占位，禁止提交真实密钥）=====
.env
.env.*
*.local

# ===== 运行时生成的上传 / 索引目录 =====
uploads/
**/uploads/

# ===== Vite 临时文件（dev server 生成，非源码）=====
vite.config.js.timestamp-*.mjs
vite.config.ts.timestamp-*.mjs

# ===== 压测脚本生成的报告（可脚本复现，不入库）=====
**/benchmark/report/
